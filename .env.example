# --- Obligatoire ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Staff ---------------------------------------------------------------------
# Rôles (par nom) autorisés à piloter la file.
STAFF_ROLES=Prof,Délégué
# Variante recommandée : identifiants de rôles (insensible au renommage).
# STAFF_ROLE_IDS=123456789012345678,234567890123456789
# Identifiants Discord toujours autorisés (dépannage).
# ADMIN_IDS=

# --- Affichage du panneau ------------------------------------------------------
# Nombre d'étudiants affichés par section (3..20).
QUEUE_PAGE_SIZE=8
# Intervalle minimal entre deux éditions du panneau, en ms (anti rate-limit).
QUEUE_MIN_EDIT_INTERVAL_MS=1500

# --- Persistance ---------------------------------------------------------------
QUEUE_DATA_FILE=data/queue-state.json
QUEUE_PERSIST_DEBOUNCE_MS=1000
# Republier le panneau au démarrage s'il a été supprimé.
QUEUE_RESTORE_BOARD=true
# Salon où republier le panneau si le message sauvegardé a disparu.
# QUEUE_CHANNEL_ID=

# --- Bienvenue -----------------------------------------------------------------
ENABLE_WELCOME=true
# Requiert l'intent privilégié « Server Members » dans le portail développeur.
ENABLE_MEMBER_INTENT=true
# WELCOME_CHANNEL_ID=

# --- Divers --------------------------------------------------------------------
LOG_LEVEL=info
# PORT est fourni automatiquement par Railway.

# --- Vérification en conditions réelles (scripts/verify-live.js) ----------------
# Serveur de TEST uniquement. Le script y crée un salon temporaire puis le
# supprime. Il refuse de tourner si GUILD_ID est absent : jamais de devinette.
# GUILD_ID=
# Nombre d'inscriptions simulées pendant le test de charge.
# VERIFY_STUDENTS=50
